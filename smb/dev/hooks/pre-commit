#!/usr/bin/env bash
# Fast pre-commit for the fork: core-patch registry + oxlint on staged TS only.
# Budget ≤15s; heavy checks stay in CI (fork-ci.yaml).
# Portable for macOS /bin/bash 3.2 (no mapfile).
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "pre-commit: check-core-patches --staged…"
if ! bash scripts/check-core-patches.sh --staged; then
  echo ""
  echo "pre-commit: правки ядра без записи в docs/PATCHES.md."
  echo "  Добавь строку P-00N в docs/PATCHES.md (см. вывод выше), затем git add docs/PATCHES.md."
  exit 1
fi

STAGED_TS="$(
  git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '\.(ts|tsx)$' \
    | grep -vE '(^|/)locales/generated/' \
    || true
)"

if [ -z "$STAGED_TS" ]; then
  echo "pre-commit: нет staged .ts/.tsx — lint пропущен"
  exit 0
fi

if ! command -v npx >/dev/null 2>&1; then
  echo "pre-commit: npx нет — lint пропущен (полный lint в CI)"
  exit 0
fi

COUNT="$(echo "$STAGED_TS" | grep -c . || true)"

# Конфиг oxlint выбирается по ПЕРВОМУ файлу набора, поэтому смешанный коммит
# «фронт + сервер» гонял серверные файлы через фронтовый конфиг и давал ложные
# ошибки (18 x consistent-type-imports на sign-in-up.service.ts, 2026-10-12).
# Теперь файлы группируются по пакету и каждая группа линтится своим конфигом.
SERVER_FILES=""
FRONT_FILES=""
OTHER_FILES=""
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$f" in
    packages/twenty-server/*) SERVER_FILES="$SERVER_FILES $f" ;;
    packages/twenty-front/*) FRONT_FILES="$FRONT_FILES $f" ;;
    *) OTHER_FILES="$OTHER_FILES $f" ;;
  esac
done <<EOF
$STAGED_TS
EOF

echo "pre-commit: oxlint ($COUNT file(s), timeout 15s на группу)…"

lint_group() { # $1 = путь к .oxlintrc.json или "", $2.. = файлы
  lint_cfg="$1"
  shift
  [ $# -eq 0 ] && return 0
  if [ -n "$lint_cfg" ]; then
    run_with_timeout npx --no-install oxlint -c "$lint_cfg" "$@"
  else
    run_with_timeout npx --no-install oxlint "$@"
  fi
}

run_with_timeout() {
  # $@ = oxlint args after binary
  if command -v timeout >/dev/null 2>&1; then
    timeout 15 "$@"
    return $?
  fi
  if command -v gtimeout >/dev/null 2>&1; then
    gtimeout 15 "$@"
    return $?
  fi
  # macOS without coreutils: background + kill
  "$@" &
  pid=$!
  (
    sleep 15
    kill "$pid" 2>/dev/null
  ) &
  watcher=$!
  set +e
  wait "$pid"
  rc=$?
  set -e
  kill "$watcher" 2>/dev/null || true
  wait "$watcher" 2>/dev/null || true
  return "$rc"
}

set +e
rc=0
had_timeout=0
run_group_and_track() {
  "$@"
  group_rc=$?
  case "$group_rc" in
    124|137|143) had_timeout=1 ;;
    0) ;;
    *) [ "$rc" -eq 0 ] && rc="$group_rc" ;;
  esac
}
run_group_and_track lint_group packages/twenty-server/.oxlintrc.json $SERVER_FILES
run_group_and_track lint_group packages/twenty-front/.oxlintrc.json $FRONT_FILES
run_group_and_track lint_group "" $OTHER_FILES
set -e

if [ "$rc" -eq 0 ] && [ "$had_timeout" -eq 1 ]; then
  echo "pre-commit: oxlint превысил 15с в одной из групп — пропуск (полный lint в CI)."
  exit 0
fi

# 124 = GNU timeout; 137/143 = SIGKILL/SIGTERM from our watcher
if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ] || [ "$rc" -eq 143 ]; then
  echo "pre-commit: oxlint превысил 15с — пропуск. Полный lint в CI (fork-ci)."
  exit 0
fi

if [ "$rc" -ne 0 ]; then
  echo "pre-commit: oxlint нашёл проблемы (exit $rc)."
  echo "  Исправь замечания. Type-aware / полный lint — в CI."
  exit "$rc"
fi

echo "pre-commit: OK"
exit 0
