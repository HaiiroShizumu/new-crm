# Copy to /opt/crm/{staging,prod}/.env and chmod 600. Never commit real secrets.

CRM_ENV=staging
TAG=sha-REPLACE_ME
HOST_PORT=3001

# Root of the instance, not a workspace host. With multi-workspace on, every
# workspace lives on <subdomain>.<this host> and DEFAULT_SUBDOMAIN serves
# sign-in. The same hosts must be listed in the Caddy environment.
SERVER_URL=https://REPLACE_WITH_ROOT_DOMAIN
IS_MULTIWORKSPACE_ENABLED=true
DEFAULT_SUBDOMAIN=app

PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=REPLACE_WITH_openssl_rand_hex_32
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=default

# Tune after the load test (5 workspaces x 50 users); these are the defaults.
# PG_POOL_MAX_CONNECTIONS=10
# PG_SHARED_BUFFERS=512MB
# PG_EFFECTIVE_CACHE_SIZE=1536MB

REDIS_URL=redis://redis:6379

# openssl rand -base64 32 — losing this key means encrypted data is unreadable
ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_base64_32
# FALLBACK_ENCRYPTION_KEY=
# APP_SECRET=  # legacy only; generate with openssl rand -hex 32 if needed

# local keeps files in the server-local-data volume (included in no backup
# unless the volume is dumped). s3 works with any S3-compatible storage.
STORAGE_TYPE=local
# STORAGE_TYPE=s3
# STORAGE_S3_REGION=
# STORAGE_S3_NAME=
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# Lets the browser download straight from the bucket instead of through Node.
# STORAGE_S3_PRESIGNED_URL_ENABLED=true
# Only when STORAGE_S3_ENDPOINT is not reachable from the browser.
# STORAGE_S3_PRESIGNED_URL_BASE=

# Required behind Caddy (otherwise client IP / rate limits break)
TRUST_PROXY="loopback, linklocal, uniquelocal"

# Bitrix24 marketplace application (docs/adr/ADR-015-bitrix-channel.md,
# docs/ops/bitrix-app.md). Both or neither; empty means the channel is off.
SMB_BITRIX_CLIENT_ID=
SMB_BITRIX_CLIENT_SECRET=
# true: installing the application on a portal creates the company by itself
# (workspace on its own subdomain, its database schema, accounts for the
# portal employees). Empty: the portal waits for `smb:bitrix:bind-portal`.
SMB_BITRIX_AUTO_PROVISION_WORKSPACE=
# Automatic creation also needs the core restriction below lifted: by default
# only server admins may create a workspace, and the portal administrator who
# installs the application is not one. Lifting it opens workspace creation on
# the public sign-up page as well (the core still stops at 5 per instance), so
# this is the owner's decision per server: docs/ops/bitrix-app.md.
# IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=false

# DISABLE_DB_MIGRATIONS=
# DISABLE_CRON_JOBS_REGISTRATION=

# --- prod differs only in (separate /opt/crm/prod/.env) ---
# CRM_ENV=prod
# HOST_PORT=3000
# TAG=v2.45.6-smb.1
