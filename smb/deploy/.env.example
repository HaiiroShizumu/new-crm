# Copy to /opt/crm/{staging,prod}/.env and chmod 600. Never commit real secrets.

CRM_ENV=staging
TAG=sha-REPLACE_ME
HOST_PORT=3001

SERVER_URL=https://dev.crm-systems-ai.ru

PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=REPLACE_WITH_openssl_rand_hex_32
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=default

REDIS_URL=redis://redis:6379

# openssl rand -base64 32 — losing this key means encrypted data is unreadable
ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_base64_32
# FALLBACK_ENCRYPTION_KEY=
# APP_SECRET=  # legacy only; generate with openssl rand -hex 32 if needed

STORAGE_TYPE=local

# Required behind Caddy (otherwise client IP / rate limits break)
TRUST_PROXY="loopback, linklocal, uniquelocal"

# DISABLE_DB_MIGRATIONS=
# DISABLE_CRON_JOBS_REGISTRATION=

# --- prod example values (separate /opt/crm/prod/.env) ---
# CRM_ENV=prod
# HOST_PORT=3000
# SERVER_URL=https://app.crm-systems-ai.ru
# TAG=v2.45.6-smb.1
